MAX_UPLOAD_SIZE_MB=25
CORS_ORIGINS=http://localhost:3000
DATASET_TTL_HOURS=2

# Chat agent — Google Cloud (Vertex AI / Gemini Enterprise Agent Platform).
# Auth is via Application Default Credentials, NOT an API key here:
# gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash

# Optional — only if you also want the OpenAI-compatible client available
# (e.g. testing, or deploying somewhere OpenAI's API is reachable).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini